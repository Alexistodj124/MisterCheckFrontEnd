# API
VITE_API_BASE_URL=http://localhost:5000

# Cognito Hosted UI
# Example domain: https://your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Optional overrides (defaults use window.location.origin)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Space-separated or comma-separated
VITE_COGNITO_SCOPES=openid email profile

# Optional locale hint for Hosted UI (OIDC ui_locales)
VITE_COGNITO_UI_LOCALES=es
